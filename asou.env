# 阿搜PDF工具箱 build configuration (sourced by scripts/build-asou.sh)
SIMPLE_MODE=true
SITE_URL=https://pdf.metext.xyz
ALLOW_INDEXING=true
DISABLE_GITHUB_STARS=true
VITE_DEFAULT_LANGUAGE=zh
SITE_ORG_NAME=阿搜PDF工具箱
SITE_ORG_ALT_NAMES="Asou PDF Toolbox,阿搜PDF,pdf.metext.xyz"
SITE_ORG_SAMEAS=https://github.com/chenziming808-cpu/bentopdf
COMPRESSION_MODE=g

# Self-hosted (same-origin) runtime assets, copied into dist/wasm by
# scripts/copy-selfhost-assets.mjs. Fetch them first with
# scripts/fetch-selfhost-assets.sh.
VITE_WASM_PYMUPDF_URL=/wasm/pymupdf/
VITE_WASM_GS_URL=/wasm/gs/
VITE_WASM_CPDF_URL=/wasm/cpdf/
VITE_TESSERACT_WORKER_URL=/wasm/ocr/worker.min.js
VITE_TESSERACT_CORE_URL=/wasm/ocr/core
VITE_TESSERACT_LANG_URL=/wasm/ocr/lang-data
VITE_TESSERACT_AVAILABLE_LANGUAGES=eng,chi_sim,chi_tra
VITE_OCR_FONT_BASE_URL=/wasm/ocr/fonts
VITE_EMBEDPDF_FONTS_URL=/wasm/embedpdf

# Digital signature CORS proxy intentionally left unset (see NOTICE.md).
# VITE_CORS_PROXY_URL=
DISABLE_DEFAULT_CORS_PROXY=true
VITE_ROOT_LANGUAGE=zh
